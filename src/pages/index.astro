---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe.astro";
---

<Layout title="MAXWELL MANAGEMENT | Home">

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- Hero                                                -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-10 md:py-16" data-hero>
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">

      <!-- Left: Text -->
      <div>
        <span
          class="inline-block rounded-sm bg-[var(--color-petroleum)] px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-cream)] opacity-0 translate-y-5"
          data-hero-reveal
        >
          MAXWELL MANAGEMENT
        </span>

        <h1
          id="hero-title"
          class="mt-4 text-3xl font-semibold leading-tight text-[var(--color-petroleum)] opacity-0 translate-y-5 md:text-5xl lg:text-[3.25rem]"
          data-hero-reveal
        >
          Global Industrial Supply, Orchestrated
        </h1>

        <p
          class="mt-5 text-base leading-relaxed text-[var(--color-text)] opacity-0 translate-y-5 md:text-lg"
          data-hero-reveal
        >
          Chemicals, equipment and laboratory systems —
          structured sourcing and delivery across energy markets.
        </p>

        <div class="mt-6 flex flex-wrap gap-3 opacity-0 translate-y-5" data-hero-reveal>
          <a
            href="#"
            class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 text-sm font-medium tracking-wide text-[var(--color-cream)] transition-colors hover:border-[var(--color-hover)] hover:bg-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
          >
            Request consultation
          </a>
          <a
            href="#"
            class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-border)] px-6 text-sm font-medium tracking-wide text-[var(--color-petroleum)] transition-colors hover:border-[var(--color-hover)] hover:text-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
          >
            Explore industries
          </a>
        </div>

        <ul class="mt-5 space-y-1.5 text-sm text-[var(--color-text-muted)] opacity-0 translate-y-5" data-hero-reveal>
          <li class="inline-flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
            Agent + trader model
          </li>
          <li class="inline-flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
            Multimarket logistics coordination
          </li>
          <li class="inline-flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
            Compliance-aware procurement
          </li>
        </ul>
      </div>

      <!-- Right: Globe -->
      <div
        class="overflow-hidden rounded-sm"
        style="background: radial-gradient(ellipse at center, #0f1529 0%, #0a0e1a 70%); min-height: 400px; height: 480px;"
      >
        <Globe />
      </div>
    </div>
  </section>

  <!-- Bottom spacer -->
  <div class="h-8"></div>

</Layout>

<script>
  import "../scripts/hero.ts";
</script>
