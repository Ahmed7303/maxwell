---
import Layout from "../../../layouts/Layout.astro";
import CMCMoleculeViewer from "../../../components/products/CMCMoleculeViewer.astro";
import fclsScript from "../../../scripts/fcls-page.ts?url";
---

<Layout title="Carboxymethyl Cellulose (CMC) — MAXWELL MANAGEMENT" scrollable>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SECTION 1 — Product Hero                           -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="py-10 md:py-16" data-fcls-hero>
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">

      <!-- Left: Text -->
      <div>
        <span
          class="inline-block rounded-sm bg-[var(--color-petroleum)] px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-cream)] opacity-0 translate-y-5"
          data-fcls-reveal
        >
          Chemical Reagents · Drilling Fluids
        </span>

        <h1
          class="mt-4 text-3xl font-semibold leading-tight text-[var(--color-petroleum)] opacity-0 translate-y-5 md:text-5xl lg:text-[3.25rem]"
          data-fcls-reveal
        >
          Carboxymethyl Cellulose
        </h1>

        <p
          class="mt-1 text-2xl font-light tracking-wide text-[var(--color-accent)] opacity-0 translate-y-5 md:text-3xl"
          data-fcls-reveal
        >
          CMC
        </p>

        <!-- Chemical formula -->
        <div
          class="mt-5 rounded-sm border border-[var(--color-border)] px-4 py-3 opacity-0 translate-y-5"
          style="background: rgba(27, 58, 75, 0.06);"
          data-fcls-reveal
        >
          <code class="font-mono text-sm tracking-wider text-[var(--color-petroleum)] md:text-base">
            [C<sub>6</sub>H<sub>7</sub>O<sub>2</sub>(OH)<sub>3−x</sub>(OCH<sub>2</sub>COONa)<sub>x</sub>]<sub>n</sub>
          </code>
        </div>

        <p
          class="mt-5 text-base leading-relaxed text-[var(--color-text)] opacity-0 translate-y-5 md:text-lg"
          data-fcls-reveal
        >
          Water-soluble anionic cellulose derivative. Versatile thickener,
          fluid-loss control agent, and viscosity modifier for drilling muds,
          food processing, and pharmaceutical applications.
        </p>

        <div class="mt-6 flex flex-wrap gap-3 opacity-0 translate-y-5" data-fcls-reveal>
          <a
            href="#"
            class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 text-sm font-medium tracking-wide text-[var(--color-cream)] transition-colors hover:border-[var(--color-hover)] hover:bg-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
          >
            Request Quote
          </a>
          <a
            href="#"
            class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-border)] px-6 text-sm font-medium tracking-wide text-[var(--color-petroleum)] transition-colors hover:border-[var(--color-hover)] hover:text-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
          >
            Download Datasheet
          </a>
        </div>
      </div>

      <!-- Right: 3D Molecule -->
      <div
        class="overflow-hidden rounded-sm"
        style="background: radial-gradient(ellipse at center, #0f1529 0%, #0a0e1a 70%); min-height: 400px; height: 480px;"
      >
        <CMCMoleculeViewer />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SECTION 2 — Technical Specifications               -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="border-t border-[var(--color-border)] py-12 md:py-16" data-fcls-specs>
    <h2
      class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-petroleum)] opacity-0 translate-y-5"
      data-fcls-reveal
    >
      Technical Specifications
    </h2>

    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">

      <!-- Appearance -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">White / Slightly yellowish</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Appearance (powder)</p>
      </div>

      <!-- Solubility -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">Readily water-soluble</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Solubility</p>
      </div>

      <!-- Viscosity -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2v7.5L5 19.5a1.5 1.5 0 0 0 1.3 2h11.4a1.5 1.5 0 0 0 1.3-2L14 9.5V2"/>
          <path d="M8.5 2h7"/>
          <path d="M7 15h10"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">Low / Medium / High</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Viscosity Grades</p>
      </div>

      <!-- Purity -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l8.5 5v10L12 22l-8.5-5V7L12 2z"/>
          <circle cx="12" cy="12" r="2.5"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">&ge;95%</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Purity (technical grade)</p>
      </div>

      <!-- pH Range -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
          <circle cx="11.5" cy="17.5" r="1.5" fill="currentColor"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">6.5 – 8.5</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">pH Range</p>
      </div>

      <!-- Moisture -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-5 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <svg class="mb-3 h-6 w-6 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          <path d="M3.27 6.96L12 12.01l8.73-5.05"/>
          <path d="M12 22.08V12"/>
        </svg>
        <p class="text-lg font-semibold text-[var(--color-petroleum)]">&le;10%</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Moisture Content</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SECTION 3 — Key Applications                       -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="border-t border-[var(--color-border)] py-12 md:py-16" data-fcls-apps>
    <h2
      class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-petroleum)] opacity-0 -translate-x-4"
      data-fcls-reveal
    >
      Key Applications
    </h2>

    <div class="mt-8 grid gap-3 md:grid-cols-2">

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Drilling Fluid Additive</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Fluid-loss control additive in oil &amp; gas drilling muds.</p>
        </div>
      </div>

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Food Thickener (E466)</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Thickener and stabilizer in food production processes.</p>
        </div>
      </div>

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Pharmaceutical Viscosity Modifier</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Viscosity modifier in eye drops and pharmaceutical suspensions.</p>
        </div>
      </div>

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Paper &amp; Tablet Binder</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Binder in paper production and tablet manufacturing.</p>
        </div>
      </div>

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Detergent &amp; Ceramics</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Suspending agent in detergent formulations and ceramic processing.</p>
        </div>
      </div>

      <div
        class="flex items-start gap-4 rounded-sm border-l-2 border-[var(--color-accent)] bg-white/50 p-4 transition-colors duration-200 hover:bg-white/80 opacity-0 -translate-x-4"
        data-fcls-reveal
      >
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        <div>
          <p class="font-medium text-[var(--color-petroleum)]">Cosmetics &amp; Textiles</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">Emulsifier and stabilizer in cosmetics and textile processing.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SECTION 4 — Packaging & Storage                    -->
  <!-- ═══════════════════════════════════════════════════ -->
  <section class="border-t border-[var(--color-border)] py-12 md:py-16" data-fcls-pack>
    <h2
      class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-petroleum)] opacity-0 translate-y-5"
      data-fcls-reveal
    >
      Packaging &amp; Storage
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-2">

      <!-- Packaging -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-6 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <div class="flex items-center gap-3">
          <svg class="h-7 w-7 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8z"/>
            <path d="M3.27 6.96L12 12.01l8.73-5.05"/>
            <path d="M12 22.08V12"/>
          </svg>
          <h3 class="text-base font-semibold text-[var(--color-petroleum)]">Packaging</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-[var(--color-text)]">
          <strong class="text-[var(--color-petroleum)]">25 kg</strong> net weight per unit.
          Supplied in kraft paper bag with PE liner for optimal moisture barrier and product integrity.
        </p>
      </div>

      <!-- Storage -->
      <div
        class="rounded-sm border border-[var(--color-border)] bg-white/60 p-6 transition-all duration-200 hover:border-[var(--color-accent)] hover:shadow-sm opacity-0 translate-y-5"
        data-fcls-reveal
      >
        <div class="flex items-center gap-3">
          <svg class="h-7 w-7 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21V7l9-5 9 5v14"/>
            <path d="M9 21V11h6v10"/>
            <path d="M3 7l9 5 9-5"/>
          </svg>
          <h3 class="text-base font-semibold text-[var(--color-petroleum)]">Storage</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-[var(--color-text)]">
          Store in a <strong class="text-[var(--color-petroleum)]">cool, dry, ventilated area</strong>.
          Protect from moisture. Keep sealed.
          Shelf life: 24 months in original packaging.
        </p>
      </div>

    </div>
  </section>

  <!-- Bottom spacer -->
  <div class="h-8"></div>

</Layout>

<script type="module" src={fclsScript}></script>
