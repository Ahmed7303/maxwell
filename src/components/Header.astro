---
import headerScript from "../scripts/header.ts?url";
---

<header
  class="site-header sticky top-0 z-50 shrink-0 border-b border-[var(--color-border)] bg-[var(--color-bg)]"
  data-header
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-2 md:px-8">
    <a
      href="#"
      aria-label="MAXWELL MANAGEMENT homepage"
      class="inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
    >
      <img src="/brand/maxwell-logo.svg" alt="MAXWELL MANAGEMENT" class="h-12 w-auto md:h-16" loading="eager" />
    </a>

    <button
      class="inline-flex h-10 w-10 items-center justify-center rounded-sm border border-[var(--color-border)] text-[var(--color-text)] transition-colors hover:text-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] md:hidden"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav aria-label="Primary navigation" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium tracking-wide">
        <li>
          <a href="/" class="nav-link">Home</a>
        </li>

        <li class="relative" data-dropdown>
          <button
            type="button"
            class="nav-link inline-flex items-center gap-2"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="desktop-industries-menu"
            data-dropdown-trigger
          >
            Industries
            <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 0 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </button>
          <ul
            id="desktop-industries-menu"
            class="dropdown-panel invisible absolute left-1/2 top-full mt-4 w-64 -translate-x-1/2 rounded-sm border border-[var(--color-border)] bg-[var(--color-bg)] p-2 opacity-0 shadow-sm"
            role="menu"
            aria-label="Industries submenu"
            data-dropdown-menu
          >
            <li>
              <a
                href="/industries/chemical-reagents"
                role="menuitem"
                class="dropdown-link inline-flex items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/chemical.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Chemical reagents</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                role="menuitem"
                class="dropdown-link inline-flex items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/equipment.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Equipment and tools</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                role="menuitem"
                class="dropdown-link inline-flex items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/laboratory.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Laboratory equipment</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                role="menuitem"
                class="dropdown-link inline-flex items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/special.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Special clothing</span>
              </a>
            </li>
          </ul>
        </li>

        <li>
          <a href="#" class="nav-link">Partners</a>
        </li>
        <li>
          <a href="#" class="nav-link">Contact</a>
        </li>

        <li class="relative" data-dropdown>
          <button
            type="button"
            class="nav-link inline-flex items-center gap-2"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="desktop-language-menu"
            data-dropdown-trigger
          >
            <img src="/flags/gb.svg" alt="United Kingdom flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
            EN
            <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 0 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </button>
          <ul
            id="desktop-language-menu"
            class="dropdown-panel invisible absolute right-0 top-full mt-4 w-28 rounded-sm border border-[var(--color-border)] bg-[var(--color-bg)] p-2 opacity-0 shadow-sm"
            role="menu"
            aria-label="Language selector"
            data-dropdown-menu
          >
            <li>
              <a href="#" role="menuitem" class="dropdown-link inline-flex items-center gap-2">
                <img src="/flags/gb.svg" alt="United Kingdom flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
                EN
              </a>
            </li>
            <li>
              <a href="#" role="menuitem" class="dropdown-link inline-flex items-center gap-2">
                <img src="/flags/ru.svg" alt="Russia flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
                RU
              </a>
            </li>
            <li>
              <a href="#" role="menuitem" class="dropdown-link inline-flex items-center gap-2">
                <img src="/flags/lv.svg" alt="Latvia flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
                LV
              </a>
            </li>
          </ul>
        </li>
      </ul>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu hidden border-t border-[var(--color-border)] bg-[var(--color-bg)] md:hidden"
    data-mobile-menu
  >
    <nav class="mx-auto max-w-7xl px-5 py-5" aria-label="Mobile navigation">
      <ul class="space-y-1 text-sm font-medium tracking-wide">
        <li><a href="/" class="mobile-link">Home</a></li>
        <li>
          <button
            type="button"
            class="mobile-link flex w-full items-center justify-between text-left"
            aria-expanded="false"
            aria-controls="mobile-industries-panel"
            data-mobile-industries-toggle
          >
            <span class="inline-flex items-center gap-3">
              <span>Industries</span>
            </span>
            <svg
              aria-hidden="true"
              class="h-4 w-4 shrink-0 transition-transform"
              viewBox="0 0 20 20"
              fill="currentColor"
              data-mobile-industries-icon
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 0 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </button>
          <ul
            id="mobile-industries-panel"
            class="hidden space-y-1 pb-1 pl-4 pt-1"
            aria-label="Mobile industries submenu"
            data-mobile-industries-panel
          >
            <li>
              <a
                href="/industries/chemical-reagents"
                class="mobile-sublink inline-flex min-h-10 items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/chemical.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Chemical reagents</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="mobile-sublink inline-flex min-h-10 items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/equipment.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Equipment and tools</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="mobile-sublink inline-flex min-h-10 items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/laboratory.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Laboratory equipment</span>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="mobile-sublink inline-flex min-h-10 items-center gap-3 [&>img]:opacity-80 hover:[&>img]:opacity-100 focus-visible:[&>img]:opacity-100"
              >
                <img
                  src="/industries/special.svg"
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="h-auto w-5 shrink-0"
                  loading="lazy"
                />
                <span>Special clothing</span>
              </a>
            </li>
          </ul>
        </li>
        <li><a href="#" class="mobile-link">Partners</a></li>
        <li><a href="#" class="mobile-link">Contact</a></li>
        <li class="pt-2">
          <p class="px-2 py-1 text-xs uppercase tracking-[0.16em] text-[var(--color-text-muted)]">Language</p>
          <div class="flex gap-2 px-2 pt-1">
            <a href="#" class="lang-chip inline-flex min-h-10 items-center gap-2" aria-label="English">
              <img src="/flags/gb.svg" alt="United Kingdom flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
              EN
            </a>
            <a href="#" class="lang-chip inline-flex min-h-10 items-center gap-2" aria-label="Russian">
              <img src="/flags/ru.svg" alt="Russia flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
              RU
            </a>
            <a href="#" class="lang-chip inline-flex min-h-10 items-center gap-2" aria-label="Latvian">
              <img src="/flags/lv.svg" alt="Latvia flag" width="18" height="12" class="h-auto w-[18px] shrink-0" loading="lazy" />
              LV
            </a>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script type="module" src={headerScript}></script>
