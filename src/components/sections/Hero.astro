---
import Globe from "../Globe.astro";
import heroScript from "../../scripts/hero.ts?url";
---

<section
  class="grid h-full w-full items-center gap-4 md:grid-cols-2 md:gap-10"
  aria-labelledby="hero-title"
  data-hero
>
  <div class="flex max-w-[34rem] flex-col justify-center" data-hero-text>
    <p
      class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-petroleum)]"
      data-hero-reveal
    >
      MAXWELL MANAGEMENT
    </p>
    <h1
      id="hero-title"
      class="mt-2 text-4xl font-semibold leading-tight text-[var(--color-petroleum)] md:text-5xl"
      data-hero-reveal
    >
      Global Industrial Supply, Orchestrated
    </h1>
    <p class="mt-2 text-base leading-relaxed text-[var(--color-text)] md:text-lg" data-hero-reveal>
      Chemicals, equipment and laboratory systems — structured sourcing and delivery across energy markets.
    </p>

    <div class="mt-3 flex flex-wrap gap-3" data-hero-reveal>
      <a
        href="#"
        class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-accent)] bg-[var(--color-accent)] px-5 text-sm font-medium tracking-wide text-[var(--color-cream)] transition-colors hover:border-[var(--color-hover)] hover:bg-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
      >
        Request consultation
      </a>
      <a
        href="#"
        class="inline-flex min-h-11 items-center justify-center rounded-sm border border-[var(--color-border)] px-5 text-sm font-medium tracking-wide text-[var(--color-petroleum)] transition-colors hover:border-[var(--color-hover)] hover:text-[var(--color-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-hover)]"
      >
        Explore industries
      </a>
    </div>

    <ul class="mt-3 space-y-1 text-sm text-[var(--color-text-muted)]" data-hero-reveal>
      <li class="inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
        Agent + trader model
      </li>
      <li class="inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
        Multimarket logistics coordination
      </li>
      <li class="inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-sage)]"></span>
        Compliance-aware procurement
      </li>
    </ul>
  </div>

  <div
    class="self-center overflow-hidden rounded-sm"
    style="background: #0a0e1a;"
    data-hero-map
  >
    <Globe />
  </div>
</section>

<script type="module" src={heroScript}></script>

<script>
  function syncGlobeHeight() {
    const text = document.querySelector('[data-hero-text]');
    const map = document.querySelector('[data-hero-map]');
    if (!text || !map || window.innerWidth < 768) {
      if (map) map.style.height = '';
      return;
    }
    map.style.height = text.offsetHeight + 'px';
  }
  syncGlobeHeight();
  window.addEventListener('resize', syncGlobeHeight);
</script>
