---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  scrollable?: boolean;
}

const { title = "MAXWELL MANAGEMENT", scrollable = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      "flex flex-col bg-[var(--color-bg)] text-[var(--color-text)] antialiased",
      scrollable ? "min-h-screen" : "h-screen overflow-hidden",
    ]}
  >
    <Header />
    <main
      class="mx-auto w-full max-w-7xl flex-1 px-5 md:px-8"
      style={scrollable ? undefined : "min-height:0"}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

