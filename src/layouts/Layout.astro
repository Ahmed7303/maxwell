---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "MAXWELL MANAGEMENT" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)] antialiased"
  >
    <Header />
    <main
      class="mx-auto w-full max-w-7xl flex-1 px-5 md:px-8"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

